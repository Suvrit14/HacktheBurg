{% extends "layout.njk" %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block mainContent %}
  <h1 class="govuk-heading-l">Cookies</h1>
  <p class="govuk-body">Cookies are small files saved on your phone, tablet or computer when you visit a website.</p>
  <p class="govuk-body">We use one essential cookie to remember your answers as you go through the application. We do not need to ask permission to use it, and we do not use any analytics or advertising cookies.</p>

  <h2 class="govuk-heading-m">Essential cookies</h2>
  {{ govukTable({
    head: [ { text: "Name" }, { text: "Purpose" }, { text: "Expires" } ],
    rows: [
      [ { text: "badge_session" }, { text: "Remembers your answers while you apply" }, { text: "When you close your browser" } ]
    ]
  }) }}
{% endblock %}
