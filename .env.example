# Copy to .env and fill in. .env is gitignored.

# AWS Bedrock model the team chooses. Newer Claude models need the inference-profile id,
# e.g. us.anthropic.claude-haiku-5-5 (not anthropic.claude-haiku-5-5).
MYOPILOT_MODEL_ID=
# Optional: a faster/cheaper model just for the per-page option menus (defaults to MYOPILOT_MODEL_ID)
MYOPILOT_OPTIONS_MODEL_ID=
AWS_REGION=
# Optional: named profile from ~/.aws/credentials (leave empty for default)
AWS_PROFILE=

# Demo safety: never press the final submit button on live websites (keep true for the demo)
MYOPILOT_LIVE_NO_SUBMIT=true
MYOPILOT_MAX_STEPS=40

# Browser the agent drives: chrome (installed Google Chrome) or chromium (Playwright bundled)
MYOPILOT_BROWSER=chrome

# EMG subject (NinaPro DB5, 1-10). The ONE place to change it: the notebook (m1.ipynb), the saved model
# (models/subject<N>_set_a.joblib) and the browser pipeline's --emg all follow this value.
EMG_SUBJECT=2
